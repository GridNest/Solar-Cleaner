# ==============================================================
# SolarCleaner.in - Environment Configuration Guide
# ==============================================================

# 1. MongoDB Atlas Database Connection
# Replace with your MongoDB Atlas cluster connection string:
# Example: mongodb+srv://myUsername:myStrongPassword@cluster0.abcde.mongodb.net/solar_cleaner?retryWrites=true&w=majority
MONGODB_URI=

# 2. Admin Security Password (for Phase 3 CMS & Leads Dashboard)
ADMIN_PASSWORD=admin@solar2026

# 3. Email Notification Configuration (SMTP / Gmail / Hostinger / Zoho)
# For Gmail, generate an 'App Password' from your Google Account Security settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
NOTIFICATION_EMAIL_TO=admin@solarcleaner.in
